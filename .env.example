PORT=4000
DATABASE_URL=postgres://bm:bm@localhost:5432/bm_central

JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated origins allowed to open the realtime WebSocket from a browser.
CORS_ORIGINS=http://localhost:3000

# --- MQTT (broker-neutral; only these lines change if the broker changes) ---
# Which broker calls our auth/ACL hooks: mosquitto (mosquitto-go-auth HTTP backend) or emqx.
MQTT_BROKER=mosquitto
# mqtt://, mqtts://, ws:// or wss://. Leave empty to run without a broker.
# Same VPS as Mosquitto: mqtt://127.0.0.1:1883. Remote: mqtts://mqtt.bongomaker.com:8883
MQTT_URL=mqtt://127.0.0.1:1883
# The backend's own broker account (superuser). Not stored in mqtt_users.
MQTT_USERNAME=bm-central
MQTT_PASSWORD=change-me
MQTT_CLIENT_ID=bmc-backend
MQTT_TOPIC_PREFIX=devices
MQTT_QOS=1
# PEM CA bundle for mqtts:// with a private CA.
MQTT_CA_FILE=
# Shared secret the broker sends to /api/v1/mqtt/{auth,superuser,acl}
# (?secret= for mosquitto-go-auth, header x-hook-secret for EMQX).
MQTT_HOOK_SECRET=change-me-too

# Seconds without any message before a device counts as offline (firmware should heartbeat faster).
DEVICE_OFFLINE_AFTER=90
# Seconds before an unacknowledged command shows as expired.
COMMAND_TTL=60

# Proxies allowed to set X-Forwarded-For (Express "trust proxy"). Keep loopback when
# Next.js/nginx run on the same host; list their IPs otherwise.
TRUST_PROXY=loopback
